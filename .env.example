# --- GoHighLevel (use ONE of the two options) ---
# Option A (simplest): Inbound Webhook URL from a GHL workflow trigger
GHL_WEBHOOK_URL=
# Option B: LeadConnector API v2 (Private Integration token + Location ID)
GHL_API_TOKEN=
GHL_LOCATION_ID=

# --- KYC application (optional) ---
# Secure endpoint of your KYC provider / backend that receives the FULL KYC form (incl. files).
# If empty, sensitive KYC fields and documents are NOT stored or forwarded anywhere.
KYC_FORWARD_URL=
KYC_FORWARD_TOKEN=
